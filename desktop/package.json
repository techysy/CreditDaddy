{
  "name": "creditdaddy-desktop",
  "productName": "CreditDaddy",
  "version": "1.4.0",
  "description": "CreditDaddy desktop shell - Qoder / WorkBuddy / ZCode / mirasim / 妙手 / Trae 多账号管理与每日积分自动签到",
  "main": "main.js",
  "author": "techysy",
  "license": "MIT",
  "scripts": {
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.techysy.creditdaddy",
    "productName": "CreditDaddy",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "preload-container.js",
      "passwordStore.js",
      "package.json",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CreditDaddy-Win-Setup-${version}.${ext}",
      "shortcutName": "CreditDaddy"
    },
    "portable": {
      "artifactName": "CreditDaddy-Win-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "server",
        "to": "creditdaddy"
      }
    ],
    "dmg": {
      "artifactName": "CreditDaddy-Mac-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "techysy",
      "repo": "CreditDaddy"
    }
  },
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
