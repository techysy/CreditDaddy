{
  "name": "creditdaddy-desktop",
  "productName": "CreditDaddy",
  "version": "0.7.2",
  "description": "CreditDaddy desktop shell - Qoder / WorkBuddy / ZCode 多账号管理与每日积分自动签到",
  "main": "main.js",
  "author": "techysy",
  "license": "MIT",
  "scripts": {
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.techysy.creditdaddy",
    "productName": "CreditDaddy",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CreditDaddy-Setup-${version}.${ext}",
      "shortcutName": "CreditDaddy"
    },
    "portable": {
      "artifactName": "CreditDaddy-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "server",
        "to": "creditdaddy"
      }
    ]
  },
  "type": "commonjs"
}
